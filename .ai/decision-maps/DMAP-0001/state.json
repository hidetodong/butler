  "decisions": {
    "DEC-0001": {
      "abandon": null,
      "claim": null,
      "depends_on": [],
      "id": "DEC-0001",
      "question": "Which Butler confirmations fit native cards versus text or HITL?",
      "resolution": {
        "at": "2026-08-02T06:10:00Z",
        "evidence": [
          "repo:.ai/milestone-backlog/codex-structured-question-cards.md",
          "repo:Coder/20_Workflow_Lifecycle/acceptance-schema.md",
          "repo:Coder/20_Workflow_Lifecycle/tech-plan-schema.md",
          "decision-work:.ai/decision-work/DMAP-0001/DEC-0001/ATT-0001/result.json#sha256:989f4975db90f3bed3261a64182c4d8febcc1a9f945f06a1397b8986a6839804"
        ],
        "outcome": "Use native cards only for bounded mutually exclusive confirmations; preserve text or HITL for open and true multi-select questions",
        "rationale": "The current repository contracts support this bounded conclusion"
      },
      "status": "resolved"
    },
    "DEC-0002": {
      "abandon": null,
      "claim": null,
      "depends_on": [],
      "id": "DEC-0002",
      "question": "What Claude, Codex and Pi capability boundary can Butler honestly promise?",
      "resolution": {
        "at": "2026-08-02T06:10:00Z",
        "evidence": [
          "repo:workflows/registry.json",
          "repo:plugins/butler/skills/butler-router/SKILL.md",
          "repo:plugins/butler-pi/index.ts",
          "decision-work:.ai/decision-work/DMAP-0001/DEC-0002/ATT-0002/result.json#sha256:cb0604fed1fbde4478c44ef8e85e93627e14c8c2e1bc4b8898e94215fc7e9ec5"
        ],
        "outcome": "Describe stable capabilities rather than internal tool names; Claude and Codex have workflow entries while Pi currently provides shared gates only",
        "rationale": "The current repository contracts support this bounded conclusion"
      },
      "status": "resolved"
    },
    "DEC-0003": {
      "abandon": null,
      "claim": null,
      "depends_on": [
        "DEC-0001",
        "DEC-0002"
      ],
      "id": "DEC-0003",
      "question": "What evidence would justify a custom UI or external coordination tracker?",
      "resolution": {
        "at": "2026-08-02T06:11:00Z",
        "evidence": [
          "decision:DEC-0001",
          "decision:DEC-0002",
          "dogfood:tools/explore-dogfood/scenario.py"
        ],
        "outcome": "Build an external layer only after observing concrete multi-machine, multi-writer, query/notification, or scale blockers; current evidence supports defer",
        "rationale": "The local workflow recovered correctly and no external coordination blocker was observed; a single local run cannot justify implementation"
      },
      "status": "resolved"
    }
  },
