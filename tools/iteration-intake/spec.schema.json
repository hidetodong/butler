{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Butler session-to-iteration intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "confirmed_decisions", "model_recommendations", "open_questions", "in_scope", "out_of_scope"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "confirmed_decisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "model_recommendations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "in_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "milestone_route": {"type": ["string", "null"], "pattern": "^R[1-9][0-9]*$"}
  }
}
