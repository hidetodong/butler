    },
    {
      "file": "tools/delivery-selftest/README.md",
      "must_contain": ["`state` 机器码（ASCII）：`pass` / `fail` / `skip` / `defer`"],
      "reason": "四态机器码枚举由桥 README 独占，改名或删除即失去唯一真源"
    },
    {
      "file": "tools/delivery-selftest/README.md",
      "must_contain": ["## 输入契约（manifest JSON）", "## 输出契约（results JSON）"],
      "reason": "桥的 manifest/results 输入输出契约由桥 README 独占，段落删除即失去唯一真源"
    },
    {
      "file": "Coder/65_Extension_Dangerous/dangerous-engine.md",
      "must_not_contain": ["复用 `55_Extension_ConvergenceLoop", "复用收敛闭环"],
      "must_contain": ["bounded-convergence.md"],
      "reason": "Dangerous 与 Loop 并列，不复用 Loop 模块、须引用共享有界收敛策略"
    },
    {
      "file": "Coder/55_Extension_ConvergenceLoop/convergence-loop-engine.md",
      "must_not_contain": ["直接复用本模块"],
      "must_contain": ["bounded-convergence.md"],
      "reason": "Loop 不得自称被 Dangerous 直接复用、须引用共享有界收敛策略"
    },
    {
      "file": "Coder/30_Quality_Gate/correction-contract.md",
      "must_not_contain": ["复用收敛闭环"],
      "reason": "correction-contract 不得写 Dangerous 复用 Loop"
    },
    {
      "file": "Coder/00_System_Prompt/logic-protocol.md",
      "must_not_contain": ["以收敛闭环跑完整生命周期"],
      "reason": "Dangerous 描述不得把 Loop 当必然组成"
    },
    {
      "file": "Coder/README.md",
      "must_not_contain": ["P4 复用收敛闭环"],
      "reason": "README 不得写 Dangerous 复用 Loop"
    },
    {
      "file": "tools/artifact-pipeline/templates/VERIFY_REPORT.md",
      "must_contain": ["## 人测道小结"],
      "reason": "人测道小结段结构由模板拥有"
    },
    {
      "file": "tools/artifact-pipeline/artifacts.v1.json",
      "must_contain": ["人测道小结"],
      "reason": "人测道小结段由 manifest 拥有"
    },
    {
      "file": "Coder/20_Workflow_Lifecycle/verify-schema.md",
      "must_not_contain": ["无则整段省略"],
      "reason": "verify-schema 不得自立人测段省略口径"
    }
  ]
